{
	"name": "svelte-query-builder",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && pnpm prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "pnpm test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./headless": {
			"types": "./dist/headless.d.ts",
			"svelte": "./dist/headless.js"
		},
		"./dnd": {
			"types": "./dist/dnd.d.ts",
			"svelte": "./dist/dnd.js"
		},
		"./formatQuery": {
			"types": "./dist/format-query.d.ts",
			"svelte": "./dist/format-query.js"
		},
		"./transformQuery": {
			"types": "./dist/transform-query.d.ts",
			"svelte": "./dist/transform-query.js"
		},
		"./parseSQL": {
			"types": "./dist/parsers/parse-sql.d.ts",
			"svelte": "./dist/parsers/parse-sql.js"
		},
		"./parseMongoDB": {
			"types": "./dist/parsers/parse-mongodb.d.ts",
			"svelte": "./dist/parsers/parse-mongodb.js"
		},
		"./parseCEL": {
			"types": "./dist/parsers/parse-cel.d.ts",
			"svelte": "./dist/parsers/parse-cel.js"
		},
		"./parseSpEL": {
			"types": "./dist/parsers/parse-spel.d.ts",
			"svelte": "./dist/parsers/parse-spel.js"
		},
		"./parseJSONata": {
			"types": "./dist/parsers/parse-jsonata.d.ts",
			"svelte": "./dist/parsers/parse-jsonata.js"
		},
		"./parseJsonLogic": {
			"types": "./dist/parsers/parse-jsonlogic.d.ts",
			"svelte": "./dist/parsers/parse-jsonlogic.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/compat": "^1.4.1",
		"@eslint/js": "^9.39.4",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.14.0",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.4",
		"bits-ui": "^2.16.3",
		"clsx": "^2.1.1",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"jsdom": "^26.0.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"publint": "^0.3.2",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"svelte-sonner": "^1.1.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^6.2.6",
		"vitest": "^3.0.0"
	},
	"keywords": [
		"svelte"
	],
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@react-querybuilder/core": "~8.15.0",
		"svelte-dnd-action": "^0.9.69"
	}
}
